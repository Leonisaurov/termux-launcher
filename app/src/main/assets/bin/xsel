#!/data/data/com.termux/files/usr/bin/bash
#
# xsel - Fast clipboard tool for Termux Android
# Uses local TCP socket (127.0.0.1:18787) for instant clipboard access.
# Falls back to cmd clipboard or termux-clipboard if socket unavailable.
# If X11 is detected, delegates to system xsel.

# Detect X11
if [ -n "$DISPLAY" ] && command -v /usr/bin/xsel &>/dev/null; then
    exec /usr/bin/xsel "$@"
fi

XSEL_PORT=18787
XSEL_HOST="127.0.0.1"

# Check if /dev/tcp connection is possible (silent)
has_dev_tcp() {
    { exec 3<>/dev/tcp/${XSEL_HOST}/${XSEL_PORT}; } 2>/dev/null
}

# Clipboard functions via TCP socket
get_clipboard_socket() {
    has_dev_tcp || return 1
    echo "GET" >&3
    IFS= read -r line <&3
    exec 3>&-
    echo "$line"
    return 0
}

set_clipboard_socket() {
    local text="$1"
    has_dev_tcp || return 1
    echo "SET:${text}" >&3
    IFS= read -r response <&3
    exec 3>&-
    [ "$response" = "OK" ]
}

# Fallback: cmd clipboard (Android native)
get_clipboard_cmd() {
    command -v cmd &>/dev/null || return 1
    cmd clipboard get-text 2>/dev/null
}

set_clipboard_cmd() {
    local text="$1"
    command -v cmd &>/dev/null || return 1
    cmd clipboard put-text "$text" 2>/dev/null
}

# Fallback: termux-clipboard (Termux:API)
get_clipboard_termux() {
    command -v termux-clipboard-get &>/dev/null || return 1
    termux-clipboard-get 2>/dev/null
}

set_clipboard_termux() {
    local text="$1"
    command -v termux-clipboard-set &>/dev/null || return 1
    echo -n "$text" | termux-clipboard-set 2>/dev/null
}

# Try backends in order: socket > cmd > termux-clipboard
get_clipboard() {
    local result
    result=$(get_clipboard_socket) && { echo "$result"; return 0; }
    result=$(get_clipboard_cmd) && { echo "$result"; return 0; }
    result=$(get_clipboard_termux) && { echo "$result"; return 0; }
    return 1
}

set_clipboard() {
    local text="$1"
    set_clipboard_socket "$text" && return 0
    set_clipboard_cmd "$text" && return 0
    set_clipboard_termux "$text" && return 0
    return 1
}

# Parse arguments
ACTION=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output|--primary) ACTION="get" ;;
        -i|--input)  ACTION="set" ;;
        -c|--clear)  ACTION="clear" ;;
        -b|--clipboard) ;;
        -h|--help)
            echo "Usage: xsel [-o|-i|-c|-b]"
            echo ""
            echo "  -o, --output   Print clipboard to stdout"
            echo "  -i, --input    Read stdin into clipboard"
            echo "  -c, --clear    Clear clipboard"
            echo "  -b, --clipboard Use clipboard selection (default)"
            echo ""
            echo "If DISPLAY is set, delegates to system xsel."
            exit 0
            ;;
        *) echo "xsel: unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

[ -z "$ACTION" ] && ACTION="get"

case "$ACTION" in
    get)
        get_clipboard
        if [ $? -ne 0 ]; then
            echo "xsel: no clipboard backend available (is app running?)" >&2
            exit 1
        fi
        ;;
    set)
        set_clipboard "$(cat)"
        if [ $? -ne 0 ]; then
            echo "xsel: no clipboard backend available (is app running?)" >&2
            exit 1
        fi
        ;;
    clear)
        set_clipboard ""
        if [ $? -ne 0 ]; then
            echo "xsel: no clipboard backend available (is app running?)" >&2
            exit 1
        fi
        ;;
esac