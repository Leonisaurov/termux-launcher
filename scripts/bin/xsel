#!/data/data/com.termux/files/usr/bin/bash
#
# xsel - X11 clipboard tool for Termux Android
# Uses multiple backends: cmd clipboard, termux-clipboard, ContentProvider
# If X11 is detected, delegates to system xsel.

# Detect X11
if [ -n "$DISPLAY" ] && command -v /usr/bin/xsel &>/dev/null; then
    exec /usr/bin/xsel "$@"
fi

# --- Backend detection ---
BACKEND=""

# 1. Try cmd clipboard (Android native, works on most devices)
if [ -z "$BACKEND" ] && command -v cmd &>/dev/null; then
    if cmd clipboard get-text &>/dev/null; then
        BACKEND="cmd"
    fi
fi

# 2. Try termux-clipboard (Termux:API)
if [ -z "$BACKEND" ] && command -v termux-clipboard-get &>/dev/null; then
    if termux-clipboard-get &>/dev/null; then
        BACKEND="termux-api"
    else
        # Might work despite empty clipboard
        BACKEND="termux-api"
    fi
fi

# 3. Try ContentProvider (works on debuggable builds)
if [ -z "$BACKEND" ] && [ -x /system/bin/content ]; then
    if /system/bin/content read --uri "content://com.termux.clipboard/get" &>/dev/null; then
        BACKEND="content"
    fi
fi

# --- Backend functions ---
get_clipboard() {
    case "$BACKEND" in
        cmd)
            cmd clipboard get-text 2>/dev/null
            ;;
        termux-api)
            termux-clipboard-get 2>/dev/null
            ;;
        content)
            /system/bin/content read --uri "content://com.termux.clipboard/get" 2>/dev/null | \
                sed -n 's/.*value=//p' | head -1
            ;;
        *)
            return 1
            ;;
    esac
}

set_clipboard() {
    local text="$1"
    case "$BACKEND" in
        cmd)
            cmd clipboard put-text "$text" 2>/dev/null
            ;;
        termux-api)
            echo -n "$text" | termux-clipboard-set 2>/dev/null
            ;;
        content)
            /system/bin/content write --uri "content://com.termux.clipboard/set" \
                --bind text:s:"$text" 2>/dev/null
            ;;
        *)
            return 1
            ;;
    esac
}

# --- If no backend found, show help ---
if [ -z "$BACKEND" ]; then
    echo "xsel: no clipboard backend available" >&2
    echo "" >&2
    echo "Install Termux:API for clipboard support:" >&2
    echo "  pkg install termux-api" >&2
    echo "" >&2
    echo "Or use Android's clipboard via:" >&2
    echo "  cmd clipboard put-text <text>   (write)" >&2
    echo "  cmd clipboard get-text          (read)" >&2
    exit 1
fi

# --- Parse arguments ---
ACTION=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output|--primary) ACTION="get" ;;
        -i|--input)  ACTION="set" ;;
        -c|--clear)  ACTION="clear" ;;
        -b|--clipboard) ;; # default, ignore
        -h|--help)
            echo "Usage: xsel [-o|-i|-c|-b]"
            echo ""
            echo "  -o, --output   Print clipboard to stdout"
            echo "  -i, --input    Read stdin into clipboard"
            echo "  -c, --clear    Clear clipboard"
            echo "  -b, --clipboard Use clipboard selection (default)"
            echo ""
            echo "Backend: ${BACKEND}"
            echo "If DISPLAY is set, delegates to system xsel."
            exit 0
            ;;
        *) echo "xsel: unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

[ -z "$ACTION" ] && ACTION="get"

case "$ACTION" in
    get) get_clipboard ;;
    set) set_clipboard "$(cat)" ;;
    clear) set_clipboard "" ;;
esac
