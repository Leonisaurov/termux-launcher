#!/data/data/com.termux/files/usr/bin/bash
#
# xsel - clipboard tool for Termux Android
# Compatible with xsel(1) interface.
# If X11 is detected, delegates to system xsel.

# Detect X11
if [ -n "$DISPLAY" ] && command -v /usr/bin/xsel &>/dev/null; then
    exec /usr/bin/xsel "$@"
fi

CONTENT_PROVIDER_URI="content://com.termux.app.clipboard"

get_clipboard() {
    if [ -x /system/bin/content ] && /system/bin/content read --uri "${CONTENT_PROVIDER_URI}/get" 2>/dev/null | \
            sed -n 's/.*value=//p' | head -1 | grep -q .; then
        /system/bin/content read --uri "${CONTENT_PROVIDER_URI}/get" 2>/dev/null | \
            sed -n 's/.*value=//p' | head -1
        return
    fi
    if command -v termux-clipboard-get &>/dev/null; then
        termux-clipboard-get
        return
    fi
    echo "xsel: no clipboard backend found" >&2
    return 1
}

set_clipboard() {
    local text="$1"
    if [ -x /system/bin/content ] && /system/bin/content write --uri "${CONTENT_PROVIDER_URI}/set" \
            --bind text:s:"$text" 2>/dev/null; then
        return
    fi
    if command -v termux-clipboard-set &>/dev/null; then
        echo -n "$text" | termux-clipboard-set
        return
    fi
    echo "xsel: no clipboard backend found" >&2
    return 1
}

ACTION=""
while [ $# -gt 0 ]; do
    case "$1" in
        -o|--output|--primary) ACTION="get" ;;
        -i|--input)  ACTION="set" ;;
        -c|--clear)  ACTION="clear" ;;
        -b|--clipboard) ;; # default, ignore
        -h|--help)
            echo "Usage: xsel [-o|-i|-c|-b]"
            echo ""
            echo "  -o, --output   Print clipboard to stdout"
            echo "  -i, --input    Read stdin into clipboard"
            echo "  -c, --clear    Clear clipboard"
            echo "  -b, --clipboard Use clipboard selection (default)"
            echo ""
            echo "If DISPLAY is set, delegates to system xsel."
            exit 0
            ;;
        *) echo "xsel: unknown option: $1" >&2; exit 1 ;;
    esac
    shift
done

[ -z "$ACTION" ] && ACTION="get"

case "$ACTION" in
    get) get_clipboard ;;
    set) set_clipboard "$(cat)" ;;
    clear) set_clipboard "" ;;
esac
